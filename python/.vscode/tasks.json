{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: Run file aktif (make run)",
      "type": "shell",
      "command": "make run FILE=${relativeFile}",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Python: Daftar file (make list)",
      "type": "shell",
      "command": "make list",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: Install dependencies (make setup)",
      "type": "shell",
      "command": "make setup",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: Clean (make clean)",
      "type": "shell",
      "command": "make clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}